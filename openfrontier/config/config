# OpenFrontier Terminal Configuration
# Location: ~/.config/openfrontier/config

# Typography (matched to your Terminal.app settings)
font-family = "CaskaydiaCove Nerd Font"
font-size = 22
font-thicken = true

# Legibility & Contrast Architecture (Prevents Washed-Out Faint Text on Light Themes)
faint-opacity = 0.95
minimum-contrast = 3.5

# Window Styling & Transparency
macos-titlebar-style = transparent
window-padding-x = 12
window-padding-y = 10
window-inherit-working-directory = true

# macOS Native Keybindings & Line Editing
macos-option-as-alt = true
keybind = super+backspace=text:\x15
keybind = alt+backspace=text:\x17

# Mouse & Cursor Behavior
cursor-click-to-move = true
mouse-shift-capture = false
shell-integration = zsh

# Shell
command = /bin/zsh

# Custom Shaders (Controlled by 'shad' CLI)
custom-shader = shaders/paper-mid.glsl
custom-shader = shaders/trail.glsl
# Render the shader when terminal content changes, without forcing a
# continuous animation loop while the terminal is idle.
custom-shader-animation = true

# ==============================================================================
# GPU Split Multiplexing & Tiling Engine
# ==============================================================================
unfocused-split-opacity = 0.60
split-inherit-working-directory = true

# Native Split Controls & Navigation
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+[=goto_split:previous
keybind = super+]=goto_split:next
keybind = super+alt+left=goto_split:left
keybind = super+alt+right=goto_split:right
keybind = super+alt+up=goto_split:top
keybind = super+alt+down=goto_split:bottom
keybind = super+enter=toggle_split_zoom
keybind = super+ctrl+==equalize_splits

# Semantic Prompt Navigation (OSC 133 Telemetry)
keybind = super+up=jump_to_prompt:-1
keybind = super+down=jump_to_prompt:1
