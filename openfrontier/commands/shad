# Resolve command-line arguments
resolve_arg() {
    local cmd="$1"
    local lower
    lower=$(echo "$cmd" | tr '[:upper:]' '[:lower:]')

    case "$lower" in
        "list"|"ls")
            list_shaders
            exit 0
            ;;
        "status"|"stat"|"info")
            show_status
            exit 0
            ;;
        "help"|"-h"|"--help")
            show_help
            exit 0
            ;;
        "off"|"disable-all"|"clear"|"stop"|"none")
            disable_all_shaders
            exit 0
            ;;
        "reload")
            reload_terminal
            exit 0
            ;;
        "enable"|"add"|"+")
            shift
            if [[ $# -eq 0 ]]; then
                echo -e "${RED}Usage: shad enable <shader_name...>${RESET}" >&2
                exit 1
            fi
            for item in "$@"; do
                enable_shader "$item"
            done
            exit 0
            ;;
        "disable"|"rm"|"remove"|"del"|"-")
            shift
            if [[ $# -eq 0 ]]; then
                echo -e "${RED}Usage: shad disable <shader_name...>${RESET}" >&2
                exit 1
            fi
            for item in "$@"; do
                disable_shader "$item"
            done
            exit 0
            ;;
        "toggle"|"tog")
            shift
            if [[ $# -eq 0 ]]; then
                echo -e "${RED}Usage: shad toggle <shader_name...>${RESET}" >&2
                exit 1
            fi
            for item in "$@"; do
                toggle_shader "$item"
            done
            exit 0
            ;;
        "only"|"solo")
            shift
            if [[ $# -eq 0 ]]; then
                echo -e "${RED}Usage: shad only <shader_name>${RESET}" >&2
                exit 1
            fi
            only_shader "$1"
            exit 0
            ;;
        "set")
            shift
            local target="${1:-}"
            local t_low
            t_low=$(echo "$target" | tr '[:upper:]' '[:lower:]')
            if [[ "$t_low" == "paper" || "$t_low" == "e-paper" || "$t_low" == "grain" ]]; then
                local tier="${2:-}"
                if [[ -z "$tier" ]]; then
                    paper_config_menu
                else
                    set_paper_tier "$tier"
                fi
                exit 0
            elif [[ -n "$target" ]]; then
                enable_shader "$target"
                exit 0
            else
                echo -e "${RED}Usage: shad set paper [tier] | shad set <shader_name>${RESET}"
                exit 1
            fi
            ;;
        "paper-config"|"config-paper")
            paper_config_menu
            exit 0
            ;;
        "paper"|"paper-grain"|"grain"|"e-paper"|"fiber")
            local sub="${2:-}"
            sub=$(echo "$sub" | tr '[:upper:]' '[:lower:]')
            case "$sub" in
                "config"|"cfg"|"menu")
                    paper_config_menu
                    ;;
                "set")
                    local tier="${3:-}"
                    if [[ -z "$tier" ]]; then
                        paper_config_menu
                    else
                        set_paper_tier "$tier"
                    fi
                    ;;
                "low"|"normal"|"1")
                    set_paper_tier "low"
                    ;;
                "mid"|"more"|"2")
                    set_paper_tier "mid"
                    ;;
                "high"|"max"|"craft"|"washi"|"3")
                    set_paper_tier "high"
                    ;;
                "flat"|"kindle"|"4")
                    set_paper_tier "flat"
                    ;;
                "lamp"|"golden"|"5")
                    set_paper_tier "lamp"
                    ;;
                "off"|"0"|"stop"|"disable")
                    set_paper_tier "off"
                    ;;
                "status")
                    paper_config_hud
                    ;;
                "")
                    paper_config_menu
                    ;;
                *)
                    set_paper_tier "$sub"
                    ;;
            esac
            exit 0
            ;;
    esac

    # Direct shader arguments: could be numbers or names (e.g. 'shad trail', 'shad 1', 'shad trail paper', 'shad 1 11')
    for arg in "$@"; do
        local a_low
        a_low=$(echo "$arg" | tr '[:upper:]' '[:lower:]')
        if [[ "$a_low" =~ ^[0-9]+$ ]]; then
            if [[ "$a_low" -eq 0 ]]; then
                disable_all_shaders
            elif (( a_low >= 1 && a_low <= ${#SHADERS[@]} )); then
                local selected="${SHADERS[$((a_low - 1))]}"
                IFS=":" read -r k f d <<< "$selected"
                enable_shader "$k"
            else
                echo -e "${RED}Invalid shader number: $a_low (Range: 1-${#SHADERS[@]})${RESET}" >&2
            fi
        else
            enable_shader "$a_low"
        fi
    done
}

main() {
    if [[ $# -eq 0 ]]; then
        show_interactive_menu
    else
        resolve_arg "$@"
    fi
}

main "$@"
